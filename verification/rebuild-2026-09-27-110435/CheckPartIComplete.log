def PaperN.PartI.FixedTopologyAssignmentStatement.{u} : Prop :=
∃ μ,
  (∀ (X : Type u) [inst : TopologicalSpace X] [inst_1 : CompactSpace X] [inst_2 : Nonempty X]
      (d : PaperN.PartI.CompatibleMetric X), (↑(μ X d)).support = Set.univ) ∧
    (∀ (X Y : Type u) [inst : TopologicalSpace X] [inst_1 : CompactSpace X] [inst_2 : Nonempty X]
        [inst_3 : TopologicalSpace Y] [inst_4 : CompactSpace Y] [inst_5 : Nonempty Y]
        (d : PaperN.PartI.CompatibleMetric X) (e : PaperN.PartI.CompatibleMetric Y) (f : X ≃ᵢ Y),
        (μ X d).map ⋯ = μ Y e) ∧
      ∀ (Xs : ℕ → Type u) (X Z : Type u) [inst : (n : ℕ) → TopologicalSpace (Xs n)]
        [inst_1 : ∀ (n : ℕ), CompactSpace (Xs n)] [inst_2 : ∀ (n : ℕ), Nonempty (Xs n)] [inst_3 : TopologicalSpace X]
        [inst_4 : CompactSpace X] [inst_5 : Nonempty X] [inst_6 : MetricSpace Z] [CompactSpace Z]
        (ds : (n : ℕ) → PaperN.PartI.CompatibleMetric (Xs n)) (d : PaperN.PartI.CompatibleMetric X)
        (es : (n : ℕ) → Xs n → Z) (e : X → Z) (hes : ∀ (n : ℕ), Isometry (es n)) (he : Isometry e),
        Filter.Tendsto (fun n => Metric.hausdorffDist (Set.range (es n)) (Set.range e)) Filter.atTop (nhds 0) →
          Filter.Tendsto (fun n => (μ (Xs n) (ds n)).map ⋯) Filter.atTop (nhds ((μ X d).map ⋯))
def PaperN.PartI.GHPRetractionStatement.{u} : PaperN.PartI.GHPMetricInput → Prop :=
fun hm =>
  ∃ s,
    Function.LeftInverse PaperN.PartI.MeasuredGHSpace.forget ⇑s ∧
      Topology.IsEmbedding ⇑s ∧
        (∀ (q : GromovHausdorff.GHSpace), (s q).invariantFullSupport ∧ (s q).fullSupport) ∧
          Nonempty (GromovHausdorff.GHSpace ≃ₜ ↑(Set.range ⇑s)) ∧
            (∃ r, ∀ (x : ↑(Set.range ⇑s)), r ↑x = x) ∧
              ∀ (S : Set PaperN.PartI.MeasuredGHSpace) (hS : Set.range ⇑s ⊆ S),
                ∃ r, ∀ (x : ↑(Set.range ⇑s)), r ⟨↑x, ⋯⟩ = x
def PaperN.PartI.CommonGHCauchyEmbeddingStatement.{u} : Prop :=
∀ (Xs : ℕ → PaperN.PartI.MeasuredCompact),
  (CauchySeq fun n => GromovHausdorff.toGHSpace (Xs n).Carrier) →
    ∃ X C,
      C.HausdorffConverges ∧
        Filter.Tendsto (fun n => GromovHausdorff.toGHSpace (Xs n).Carrier) Filter.atTop
          (nhds (GromovHausdorff.toGHSpace X.Carrier))
def PaperN.PartI.LawAveragingStatement.{u, v} : {X : Type u} →
  {Y : Type v} →
    [inst : TopologicalSpace X] →
      [inst_1 : TopologicalSpace Y] →
        [inst_2 : MeasurableSpace X] →
          [inst_3 : BorelSpace X] → C(X, Y) → C(Y, MeasureTheory.ProbabilityMeasure X) → Prop :=
fun {X} {Y} [TopologicalSpace X] [TopologicalSpace Y] [MeasurableSpace X] [BorelSpace X] p s =>
  ∃ A P,
    (∀ (f : BoundedContinuousFunction X ℝ) (y : Y), (A f) y = ∫ (x : X), f x ∂↑(s y)) ∧
      (∀ (f : BoundedContinuousFunction X ℝ), 0 ≤ f → 0 ≤ A f) ∧
        A 1 = 1 ∧
          (∀ (f : BoundedContinuousFunction X ℝ), ‖A f‖ ≤ ‖f‖) ∧
            (∀ (f : BoundedContinuousFunction Y ℝ), A (f.compContinuous p) = f) ∧
              (∀ (f : BoundedContinuousFunction X ℝ), P f = (A f).compContinuous p) ∧
                (∀ (f : BoundedContinuousFunction X ℝ), P (P f) = P f) ∧
                  (Set.range ⇑P = Set.range fun f => f.compContinuous p) ∧ ‖P‖ = 1
PaperN.PartI.universalProbability_natural : ∀ (hm : PaperN.PartI.GHPMetricInput)
  (hs : PaperN.PartI.InvariantFiberLawSelectionStatement hm) (X : Type u_1) (Y : Type u_2) [inst : MetricSpace X]
  [inst_1 : CompactSpace X] [inst_2 : Nonempty X] [inst_3 : MetricSpace Y] [inst_4 : CompactSpace Y]
  [inst_5 : Nonempty Y] (e : X ≃ᵢ Y),
  (PaperN.PartI.universalProbability hm hs X).map ⋯ = PaperN.PartI.universalProbability hm hs Y
PaperN.PartI.universalProbability_tendsto : ∀ (hm : PaperN.PartI.GHPMetricInput),
  PaperN.PartI.GHPPolishInput hm →
    ∀ (hs : PaperN.PartI.InvariantFiberLawSelectionStatement hm) (Xs : ℕ → Type u_1) (X : Type u_2) (Z : Type u_3)
      [inst : (n : ℕ) → MetricSpace (Xs n)] [inst_1 : ∀ (n : ℕ), CompactSpace (Xs n)]
      [inst_2 : ∀ (n : ℕ), Nonempty (Xs n)] [inst_3 : MetricSpace X] [inst_4 : CompactSpace X] [inst_5 : Nonempty X]
      [inst_6 : MetricSpace Z] [CompactSpace Z] (es : (n : ℕ) → Xs n → Z) (e : X → Z) (hes : ∀ (n : ℕ), Isometry (es n))
      (he : Isometry e),
      Filter.Tendsto (fun n => Metric.hausdorffDist (Set.range (es n)) (Set.range e)) Filter.atTop (nhds 0) →
        Filter.Tendsto (fun n => (PaperN.PartI.universalProbability hm hs (Xs n)).map ⋯) Filter.atTop
          (nhds ((PaperN.PartI.universalProbability hm hs X).map ⋯))
PaperN.PartI.fixedTopologyAssignment_spec : ∀ (hm : PaperN.PartI.GHPMetricInput) (hp : PaperN.PartI.GHPPolishInput hm)
  (hc : PaperN.PartI.GHPCommonEmbeddingInput),
  PaperN.PartI.GHCommonEmbeddingInput →
    PaperN.PartI.ProbabilityApproximationInput →
      PaperN.PartI.InvariantValovInput hm hp hc → PaperN.PartI.FixedTopologyAssignmentStatement
PaperN.PartI.ghpRetraction_universe : ∀ (hm : PaperN.PartI.GHPMetricInput) (hp : PaperN.PartI.GHPPolishInput hm)
  (hc : PaperN.PartI.GHPCommonEmbeddingInput),
  PaperN.PartI.GHCommonEmbeddingInput →
    PaperN.PartI.ProbabilityApproximationInput →
      PaperN.PartI.InvariantValovInput hm hp hc → PaperN.PartI.GHPRetractionStatement ⋯
@PaperN.PartI.ghpEDist_measuredEquiv : ∀ {X Y : PaperN.PartI.MeasuredCompact} {A B : PaperN.PartI.MeasuredCompact}
  (ex : PaperN.PartI.MeasuredEquiv A X) (ey : PaperN.PartI.MeasuredEquiv B Y),
  PaperN.PartI.ghpEDist A B = PaperN.PartI.ghpEDist X Y
PaperN.PartI.measuredUniverseIsometry : (hm : PaperN.PartI.GHPMetricInput) →
  PaperN.PartI.MeasuredGHSpace ≃ᵢ PaperN.PartI.MeasuredGHSpace
PaperN.PartI.universalProbability_section : ∀ (hm : PaperN.PartI.GHPMetricInput)
  (hs : PaperN.PartI.InvariantFiberLawSelectionStatement hm) (X : PaperN.PartI.MeasuredCompact),
  PaperN.PartI.smallMeasuredClass
      (X.withProbability (PaperN.PartI.universalProbability hm hs X.Carrier)).toMeasuredGHSpace =
    PaperN.PartI.selectedGHSection hm hs (GromovHausdorff.toGHSpace X.Carrier)
