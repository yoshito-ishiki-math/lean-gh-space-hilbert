def PaperN.PartII.complexifiedSpectrum.{u} : {H : Type u} →
  [inst : NormedAddCommGroup H] → [inst_1 : NormedSpace ℝ H] → (H →L[ℝ] H) → Set ℂ :=
fun {H} [NormedAddCommGroup H] [NormedSpace ℝ H] T =>
  {z |
    ¬∃ S,
        S * PaperN.PartII.complexResolventBlock T z = 1 ∧
          PaperN.PartII.complexResolventBlock T z * S = 1 ∧
            S * PaperN.PartII.complexStructure = PaperN.PartII.complexStructure * S}
def PaperN.PartII.SpectralDensityStatement.{u} : Prop :=
∀ (X : Type u) [inst : MetricSpace X] [inst_1 : CompactSpace X] [Nonempty X] [inst_3 : MeasurableSpace X]
  [inst_4 : BorelSpace X] (μ : MeasureTheory.Measure X) [inst_5 : MeasureTheory.IsProbabilityMeasure μ]
  [μ.IsOpenPosMeasure] (ε : ℝ),
  0 < ε →
    ∃ η,
      0 < η ∧
        ↑η ∉ PaperN.PartII.complexifiedSpectrum (PaperN.PartII.distanceOperator μ) ∧
          ↑(-η) ∉ PaperN.PartII.complexifiedSpectrum (PaperN.PartII.distanceOperator μ) ∧
            FiniteDimensional ℝ ↥(PaperN.PartII.spectralCutoff μ η) ∧
              ⨆ x, Metric.infDist (PaperN.PartII.distanceProfile x) ↑(PaperN.PartII.spectralCutoff μ η) < ε ∧
                (Nontrivial X → 0 < Module.finrank ℝ ↥(PaperN.PartII.spectralCutoff μ η))
