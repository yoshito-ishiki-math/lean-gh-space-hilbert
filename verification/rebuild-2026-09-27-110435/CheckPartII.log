def PaperN.PartII.MinimizerContinuityStatement : Prop :=
∀ (n : ℕ),
  1 ≤ n →
    ∀ (F : ℕ → EuclideanSpace ℝ (Fin n) → ℝ) (f : EuclideanSpace ℝ (Fin n) → ℝ) (u : ℕ → EuclideanSpace ℝ (Fin n))
      (a : EuclideanSpace ℝ (Fin n)),
      (∀ (k : ℕ), Continuous (F k)) →
        Continuous f →
          (∀ (K : Set (EuclideanSpace ℝ (Fin n))), IsCompact K → TendstoUniformlyOn F f Filter.atTop K) →
            Bornology.IsBounded (Set.range u) →
              (∀ (k : ℕ) (x : EuclideanSpace ℝ (Fin n)), F k (u k) ≤ F k x) →
                (∀ (y : EuclideanSpace ℝ (Fin n)), f a ≤ f y) →
                  (∀ (x : EuclideanSpace ℝ (Fin n)), (∀ (y : EuclideanSpace ℝ (Fin n)), f x ≤ f y) → x = a) →
                    Filter.Tendsto u Filter.atTop (nhds a)
