def PaperN.PartII.DistanceKernelSpectralInput.{u} : Prop :=
∀ (X : Type u) [inst : MetricSpace X] [inst_1 : CompactSpace X] [Nonempty X] [inst_3 : MeasurableSpace X]
  [inst_4 : BorelSpace X] (μ : MeasureTheory.Measure X) [inst_5 : MeasureTheory.IsProbabilityMeasure μ],
  IsCompactOperator ⇑(PaperN.PartII.distanceOperator μ) ∧ IsSelfAdjoint (PaperN.PartII.distanceOperator μ)
def PaperN.PartII.DistanceOperatorStatement.{u} : Prop :=
∀ (X : Type u) [inst : MetricSpace X] [inst_1 : CompactSpace X] [Nonempty X] [inst_3 : MeasurableSpace X]
  [inst_4 : BorelSpace X] (μ : MeasureTheory.Measure X) [inst_5 : MeasureTheory.IsProbabilityMeasure μ]
  [μ.IsOpenPosMeasure],
  IsCompactOperator ⇑(PaperN.PartII.distanceOperator μ) ∧
    IsSelfAdjoint (PaperN.PartII.distanceOperator μ) ∧
      (∀ (f : ↥(MeasureTheory.Lp ℝ 2 μ)),
          (PaperN.PartII.continuousToL2 μ) ((PaperN.PartII.distanceToContinuous μ) f) =
              (PaperN.PartII.distanceOperator μ) f ∧
            (∀ (x : X), ((PaperN.PartII.distanceToContinuous μ) f) x = ∫ (y : X), dist x y * ↑↑f y ∂μ) ∧
              ‖(PaperN.PartII.distanceToContinuous μ) f‖ ≤ Metric.diam Set.univ * ‖f‖ ∧
                ∀ (x y : X),
                  |((PaperN.PartII.distanceToContinuous μ) f) x - ((PaperN.PartII.distanceToContinuous μ) f) y| ≤
                    dist x y * ‖f‖) ∧
        ∀ (f : ↥(MeasureTheory.Lp ℝ 2 μ)) (a : ℝ),
          a ≠ 0 → (PaperN.PartII.distanceOperator μ) f = a • f → ∃! g, (PaperN.PartII.continuousToL2 μ) g = f
